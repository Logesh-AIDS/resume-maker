# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
POSTGRES_USER=resumemaker
POSTGRES_PASSWORD=resumemaker_dev
POSTGRES_DB=resumemaker
DATABASE_URL=postgresql+asyncpg://resumemaker:resumemaker_dev@localhost:5432/resumemaker

# ─────────────────────────────────────────────
# Backend — Security
# ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────
# Backend — App
# ─────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# AI — LLM Provider
# ─────────────────────────────────────────────
# Supported: gemini (default, free), openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here   # optional

# ─────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────
# Supported: local (default), s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# ─────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
